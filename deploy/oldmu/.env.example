# Copy this file to .env and fill in the values. Never commit .env.

# The domain or public IPv4 address of the server, which the game client connects to.
PUBLIC_HOST=play.example.com

# Password of the postgres admin user. Use a long random value.
DB_ADMIN_USER=postgres
DB_ADMIN_PW=change-me

# The first admin panel user, created at the first start.
OPENMU_ADMIN_USER=admin
OPENMU_ADMIN_PASSWORD=change-me

# Website (registration). Create the key in the admin panel on the API keys page (/api-keys), role Registration,
# then restart the website: docker compose up -d website
WEBSITE_API_KEY=
# Where the Download button points to, e.g. a Google Drive / Mega link to the client archive.
DOWNLOAD_URL=
DISCORD_URL=

# Optional
# WEBSITE_PORT=80
# WEBSITE_BEHIND_PROXY=false
# Only for a test server: creates the test accounts at the first start (well-known passwords, GM rights).
# CREATE_TEST_ACCOUNTS=false
# OLDMU_TAG=latest
# ADMIN_PANEL_PORT=8080
# BACKUP_INTERVAL_SECONDS=21600
# BACKUP_KEEP_DAYS=14
