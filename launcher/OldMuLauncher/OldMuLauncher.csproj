<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OldMuLauncher</AssemblyName>
    <RootNamespace>OldMu.Launcher</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Old MU Launcher</Product>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\background.png" LogicalName="background.png" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
